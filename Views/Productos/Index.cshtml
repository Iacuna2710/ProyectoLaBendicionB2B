@model ProductoIndexViewModel
@{ ViewData["Title"] = "Productos"; }

<div class="page-header">
    <div>
        <h1>Productos</h1>
        <p class="text-muted mb-0">@Model.TotalItems producto(s) en inventario</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill">
        <i class="bi bi-plus-lg me-1"></i> Nuevo
    </a>
</div>

<div class="card-modern mb-4 p-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small text-muted">Nombre</label>
            <div class="input-group">
                <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                <input type="text" name="filtroNombre" value="@Model.FiltroNombre" class="form-control" placeholder="Buscar producto...">
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Categoría</label>
            <select name="filtroCategoria" class="form-select" asp-items="Model.Categorias">
                <option value="">Todas</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2 pt-3">
            <button type="submit" class="btn btn-outline-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="card-modern">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Productos.Any())
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">No hay productos que coincidan.</td></tr>
                }
                @foreach (var item in Model.Productos)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(item.Url_Imagen))
                                {
                                    <img src="@item.Url_Imagen" alt="" class="rounded" style="width:36px;height:36px;object-fit:cover;">
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                                <strong>@item.Nombre</strong>
                            </div>
                        </td>
                        <td><span class="badge badge-modern bg-light text-dark">@item.Categoria?.Nombre</span></td>
                        <td class="fw-semibold">₡ @item.Precio.ToString("N2")</td>
                        <td>
                            @if (item.Stock <= 5)
                            {
                                <span class="text-danger fw-semibold">@item.Stock</span>
                            }
                            else
                            {
                                <span>@item.Stock</span>
                            }
                        </td>
                        <td>
                            @if (item.Activo)
                            {
                                <span class="badge badge-modern bg-success-subtle text-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge badge-modern bg-danger-subtle text-danger">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.id_Producto" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="Ver">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.id_Producto" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.id_Producto" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <small class="text-muted">Pág. @Model.PaginaActual de @Model.TotalPaginas</small>
            <nav>
                <ul class="pagination pagination-modern mb-0">
                    <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-pagina="@(Model.PaginaActual-1)" asp-route-filtroNombre="@Model.FiltroNombre" asp-route-filtroCategoria="@Model.FiltroCategoria"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" asp-route-pagina="@i" asp-route-filtroNombre="@Model.FiltroNombre" asp-route-filtroCategoria="@Model.FiltroCategoria">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-route-pagina="@(Model.PaginaActual+1)" asp-route-filtroNombre="@Model.FiltroNombre" asp-route-filtroCategoria="@Model.FiltroCategoria"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>