@model ProductoIndexViewModel
@{ ViewData["Title"] = "Productos"; }

@{
    // Ver nota en Views/Pedido/Create.cshtml: Json.Serialize() de Razor
    // devuelve IHtmlContent y no escapa comillas dentro de un atributo HTML.
    // Usamos System.Text.Json.JsonSerializer.Serialize (string plano) en su lugar.
    // camelCase explícito: es el mismo formato que ya usa GET /api/productos
    // (ASP.NET Core lo aplica solo. Aquí, al llamar el serializador directo,
    // hay que pedirlo a mano para que React reciba las mismas keys en ambos casos).
    var opcionesJson = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };

    var categoriasJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Categorias.Select(c => new { value = c.Value, text = c.Text }), opcionesJson);

    var roles = new List<string>();
    if (User.IsInRole("Admin")) roles.Add("Admin");
    if (User.IsInRole("Ventas")) roles.Add("Ventas");
    if (User.IsInRole("Operaciones")) roles.Add("Operaciones");
    var rolesJson = System.Text.Json.JsonSerializer.Serialize(roles, opcionesJson);

    var datosInicialesJson = System.Text.Json.JsonSerializer.Serialize(Model.DatosIniciales, opcionesJson);
}

<div id="productos-root"
     data-categorias="@categoriasJson"
     data-roles="@rolesJson"
     data-filtro-nombre="@Model.FiltroNombre"
     data-filtro-categoria="@Model.FiltroCategoria"
     data-datos-iniciales="@datosInicialesJson"></div>

@section Scripts {
    <script type="module" src="~/dist/productos-index/main.js" asp-append-version="true"></script>
}
