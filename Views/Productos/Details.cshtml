@model Producto
@{ ViewData["Title"] = "Detalle de producto"; }

<div class="page-header">
    <h1>@Model.Nombre</h1>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("Operaciones"))
        {
            <a asp-action="Edit" asp-route-id="@Model.id_Producto" class="btn btn-primary rounded-pill">
                <i class="bi bi-pencil me-1"></i> Editar
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

<div class="card-modern p-4">
    <div class="row g-4">
        <div class="col-md-4 text-center">
            @if (!string.IsNullOrEmpty(Model.Url_Imagen))
            {
                <img src="@Model.Url_Imagen" alt="@Model.Nombre" class="img-fluid rounded shadow-sm" style="max-height:240px;">
            }
            else
            {
                <div class="bg-light rounded-4 d-flex align-items-center justify-content-center" style="height:200px;">
                    <i class="bi bi-image text-muted" style="font-size:3rem;"></i>
                </div>
            }
        </div>
        <div class="col-md-8">
            <div class="row g-3">
                <div class="col-sm-6">
                    <small class="text-muted d-block">Nombre</small>
                    <span class="fw-semibold">@Model.Nombre</span>
                </div>
                <div class="col-sm-6">
                    <small class="text-muted d-block">Categoría</small>
                    <span class="badge badge-modern bg-light text-dark">@Model.Categoria?.Nombre</span>
                </div>
                <div class="col-sm-6">
                    <small class="text-muted d-block">Precio</small>
                    <span class="fw-bold fs-5 text-primary">₡ @Model.Precio.ToString("N2")</span>
                </div>
                <div class="col-sm-6">
                    <small class="text-muted d-block">Impuesto</small>
                    <span>@Model.ImpuestoPorc %</span>
                </div>
                <div class="col-sm-6">
                    <small class="text-muted d-block">Stock</small>
                    <span class="fw-semibold">@Model.Stock unidades</span>
                </div>
                <div class="col-sm-6">
                    <small class="text-muted d-block">Estado</small>
                    @if (Model.Activo)
                    {
                        <span class="badge badge-modern bg-success-subtle text-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge badge-modern bg-danger-subtle text-danger">Inactivo</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>