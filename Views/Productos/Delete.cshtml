@model Producto
@{ ViewData["Title"] = "Eliminar producto"; }

<div class="page-header">
    <h1 class="text-danger">Eliminar producto</h1>
</div>

<div class="card-modern p-4">
    <div class="text-center mb-4">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:3rem;"></i>
        <h5 class="mt-2">¿Estás seguro de eliminar <strong>@Model.Nombre</strong>?</h5>
        <p class="text-muted">Si tiene pedidos asociados, se desactivará en lugar de eliminarse.</p>
    </div>
    <div class="row g-2 mb-4">
        <div class="col-sm-3"><small class="text-muted">Categoría:</small><br><span>@Model.Categoria?.Nombre</span></div>
        <div class="col-sm-3"><small class="text-muted">Precio:</small><br><span class="fw-semibold">₡ @Model.Precio.ToString("N2")</span></div>
        <div class="col-sm-3"><small class="text-muted">Stock:</small><br><span>@Model.Stock</span></div>
        <div class="col-sm-3">
            <small class="text-muted">Estado:</small><br>
            @if (Model.Activo) { <span class="badge bg-success">Activo</span> }
            else { <span class="badge bg-danger">Inactivo</span> }
        </div>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="id_Producto">
        <div class="d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-danger rounded-pill px-4">
                <i class="bi bi-trash me-1"></i> Eliminar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-x-lg me-1"></i> Cancelar
            </a>
        </div>
    </form>
</div>