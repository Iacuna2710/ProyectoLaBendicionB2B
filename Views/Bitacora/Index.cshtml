@model BitacoraIndexViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Bitácora";
    var entidades = new SelectList(new List<string> { "Producto", "Cliente", "Pedido" }, Model.FiltroEntidad);
}

<div class="page-header">
    <div>
        <h1>Bitácora de auditoría</h1>
        <p class="text-muted mb-0">@Model.TotalItems registros</p>
    </div>
</div>

<div class="card-modern mb-4 p-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small text-muted">Entidad</label>
            <select name="filtroEntidad" class="form-select" asp-items="entidades">
                <option value="">Todas</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Desde</label>
            <input type="date" name="desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" class="form-control">
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Hasta</label>
            <input type="date" name="hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" class="form-control">
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="card-modern">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Entidad</th>
                    <th>Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Registros.Any())
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">No hay registros de bitácora.</td></tr>
                }
                @foreach (var item in Model.Registros)
                {
                    <tr>
                        <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.UsuarioNombre</td>
                        <td><span class="badge badge-modern bg-light text-dark">@item.Accion</span></td>
                        <td>@item.Entidad @(item.EntidadId is not null ? $"#{item.EntidadId}" : "")</td>
                        <td>@item.Detalle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <small class="text-muted">Pág. @Model.PaginaActual de @Model.TotalPaginas</small>
            <nav>
                <ul class="pagination pagination-modern mb-0">
                    <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-pagina="@(Model.PaginaActual-1)" asp-route-filtroEntidad="@Model.FiltroEntidad" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" asp-route-pagina="@i" asp-route-filtroEntidad="@Model.FiltroEntidad" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-route-pagina="@(Model.PaginaActual+1)" asp-route-filtroEntidad="@Model.FiltroEntidad" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
