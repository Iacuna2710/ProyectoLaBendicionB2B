@model Pedido
@{ ViewData["Title"] = $"Pedido #{Model.id_Pedido}"; }

@{
    var colorEstado = Model.Estado switch
    {
        "Confirmado" => "bg-primary",
        "Enviado"    => "bg-info",
        "Entregado"  => "bg-success",
        "Cancelado"  => "bg-danger",
        _            => "bg-secondary"
    };
}

<div class="page-header">
    <div>
        <h1>Pedido #@Model.id_Pedido</h1>
        <p class="text-muted mb-0">
            Cliente: <strong>@Model.Cliente?.Nombre</strong> &middot;
            @Model.Fecha.ToString("dd/MM/yyyy HH:mm") &middot;
            <span class="badge @colorEstado">@Model.Estado</span>
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="card-modern p-3 mb-3">
        <form asp-action="CambiarEstado" asp-route-id="@Model.id_Pedido" method="post" class="d-flex align-items-end gap-2 flex-wrap">
            <div>
                <label class="form-label small text-muted mb-1">Cambiar estado del pedido</label>
                <select name="nuevoEstado" class="form-select">
                    <option value="Confirmado" selected="@(Model.Estado == "Confirmado")">Confirmado</option>
                    <option value="Enviado" selected="@(Model.Estado == "Enviado")">Enviado</option>
                    <option value="Entregado" selected="@(Model.Estado == "Entregado")">Entregado</option>
                    <option value="Cancelado" selected="@(Model.Estado == "Cancelado")">Cancelado</option>
                </select>
            </div>
            <button type="submit" class="btn btn-outline-primary rounded-pill">
                <i class="bi bi-arrow-repeat me-1"></i> Actualizar estado
            </button>
        </form>
    </div>
}

<div class="card-modern">
    <div class="table-responsive">
        <table class="table table-modern align-middle mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio unit.</th>
                    <th>Descuento %</th>
                    <th>Descuento (₡)</th>
                    <th>Impuesto %</th>
                    <th>Total línea</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    var descuentoMonto = d.PrecioUnitario * d.Cantidad * d.Descuento / 100m;
                    <tr>
                        <td>@d.Producto?.Nombre</td>
                        <td>@d.Cantidad</td>
                        <td>@d.PrecioUnitario.ToString("N2")</td>
                        <td>@d.Descuento %</td>
                        <td class="text-muted">
                            @(descuentoMonto > 0 ? $"-₡{descuentoMonto:N2}" : "₡0.00")
                        </td>
                        <td>@d.Porcentaje_Imp %</td>
                        <td>₡@d.Total_Linea.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-end gap-4 p-3 border-top">
        <div class="text-end">
            <div class="small text-muted">Subtotal</div>
            <div class="fw-semibold">₡@Model.Subtotal.ToString("N2")</div>
        </div>
        <div class="text-end">
            <div class="small text-muted">Impuestos</div>
            <div class="fw-semibold">₡@Model.Impuestos.ToString("N2")</div>
        </div>
        <div class="text-end">
            <div class="small text-muted">Total</div>
            <div class="fs-5 fw-bold text-success">₡@Model.Total.ToString("N2")</div>
        </div>
    </div>
</div>
