@model PedidoIndexViewModel
@{ ViewData["Title"] = "Pedidos"; }

<div class="page-header">
    <div>
        <h1>Pedidos</h1>
        <p class="text-muted mb-0">@Model.TotalItems pedidos </p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
    {
        <a asp-action="Create" class="btn btn-primary rounded-pill">
            <i class="bi bi-plus-lg me-1"></i> Nuevo pedido
        </a>
    }
</div>

<div class="card-modern">
    <div class="table-responsive">
        <table class="table table-modern align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Pedidos.Any())
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">No hay pedidos registrados.</td></tr>
                }
                @foreach (var p in Model.Pedidos)
                {
                    var colorEstado = p.Estado switch
                    {
                        "Confirmado" => "bg-primary",
                        "Enviado"    => "bg-info",
                        "Entregado"  => "bg-success",
                        "Cancelado"  => "bg-danger",
                        _            => "bg-secondary"
                    };
                    <tr>
                        <td>@p.id_Pedido</td>
                        <td class="fw-semibold">@p.Cliente?.Nombre</td>
                        <td>@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>₡@p.Total.ToString("N2")</td>
                        <td><span class="badge @colorEstado">@p.Estado</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@p.id_Pedido" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <small class="text-muted">Pág. @Model.PaginaActual de @Model.TotalPaginas</small>
            <nav>
                <ul class="pagination pagination-modern mb-0">
                    <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-pagina="@(Model.PaginaActual-1)"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" asp-route-pagina="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-route-pagina="@(Model.PaginaActual+1)"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
