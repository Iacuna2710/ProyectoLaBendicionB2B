@model PedidoFormViewModel
@{ ViewData["Title"] = "Nuevo pedido"; }

<div class="page-header">
    <div>
        <h1>Nuevo pedido</h1>
        <p class="text-muted mb-0">Busque productos, ajuste cantidades/descuentos y confirme.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@{
    // Ojo: Json.Serialize() de Razor devuelve IHtmlContent (Razor no le
    // escapa las comillas al interpolarlo), lo que rompería este atributo
    // HTML a la mitad. System.Text.Json.JsonSerializer.Serialize devuelve
    // un string plano, que Razor sí escapa correctamente en este contexto.
    var clientesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Clientes.Select(c => new { value = c.Value, text = c.Text }));
    var categoriasJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Categorias.Select(c => new { value = c.Value, text = c.Text }));
    var productosJson = System.Text.Json.JsonSerializer.Serialize(Model.Productos.Select(p => new
    {
        id = p.Id,
        nombre = p.Nombre,
        categoriaId = p.CategoriaId,
        precio = p.Precio,
        stock = p.Stock
    }));
}

@* El formulario y el antiforgery token siguen siendo de Razor/MVC tal cual;
   React solo controla la parte interactiva que va dentro (buscador, tabla,
   totales) — al confirmar, es un POST normal a PedidoController.Create. *@
<form asp-action="Create" method="post" id="formPedido">
    <div id="pedido-root"
         data-clientes="@clientesJson"
         data-categorias="@categoriasJson"
         data-productos="@productosJson"></div>
</form>

@section Scripts {
    <script type="module" src="~/dist/pedido/main.js" asp-append-version="true"></script>
}
