@model Cliente
@{ ViewData["Title"] = "Eliminar cliente"; }

<div class="page-header">
    <h1 class="text-danger">Eliminar cliente</h1>
</div>

<div class="card-modern p-4">
    <div class="text-center mb-4">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:3rem;"></i>
        <h5 class="mt-2">¿Eliminar a <strong>@Model.Nombre</strong>?</h5>
        <p class="text-muted">Esta acción no se puede deshacer.</p>
    </div>
    <div class="row g-2 mb-4">
        <div class="col-sm-6"><small class="text-muted">Cédula:</small><br><span>@Model.Cedula</span></div>
        <div class="col-sm-6"><small class="text-muted">Correo:</small><br><span>@Model.Correo</span></div>
        <div class="col-sm-6"><small class="text-muted">Teléfono:</small><br><span>@Model.Telefono</span></div>
    </div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="id_Cliente">
        <div class="d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-danger rounded-pill px-4">
                <i class="bi bi-trash me-1"></i> Eliminar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-x-lg me-1"></i> Cancelar
            </a>
        </div>
    </form>
</div>