@model ClienteIndexViewModel
@{ ViewData["Title"] = "Clientes"; }

<div class="page-header">
    <div>
        <h1>Clientes</h1>
        <p class="text-muted mb-0">@Model.TotalItems clientes</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill">
        <i class="bi bi-plus-lg me-1"></i> Nuevo
    </a>
</div>

<div class="card-modern mb-4 p-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small text-muted">Buscar cliente</label>
            <div class="input-group">
                <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                <input type="text" name="filtroBusqueda" value="@Model.FiltroBusqueda" class="form-control" placeholder="Buscar por nombre o cédula...">
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2 pt-3">
            <button type="submit" class="btn btn-outline-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="card-modern">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Cédula</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Clientes.Any())
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">No se encontraron clientes.</td></tr>
                }
                @foreach (var item in Model.Clientes)
                {
                    <tr>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td><span class="badge badge-modern bg-light text-dark">@item.Cedula</span></td>
                        <td>@item.Correo</td>
                        <td>@item.Telefono</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.id_Cliente" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="Ver">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.id_Cliente" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.id_Cliente" class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center p-3 border-top">
            <small class="text-muted">Pág. @Model.PaginaActual de @Model.TotalPaginas</small>
            <nav>
                <ul class="pagination pagination-modern mb-0">
                    <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                        <a class="page-link" asp-route-pagina="@(Model.PaginaActual-1)" asp-route-filtroBusqueda="@Model.FiltroBusqueda"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" asp-route-pagina="@i" asp-route-filtroBusqueda="@Model.FiltroBusqueda">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-route-pagina="@(Model.PaginaActual+1)" asp-route-filtroBusqueda="@Model.FiltroBusqueda"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>