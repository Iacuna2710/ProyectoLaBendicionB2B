@model Categoria
@{ ViewData["Title"] = "Detalle de categoría"; }

<div class="page-header">
    <h1>@Model.Nombre</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.id_Categoria" class="btn btn-primary rounded-pill">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

<div class="card-modern p-4">
    <div class="row g-3">
        <div class="col-sm-6">
            <small class="text-muted d-block">ID</small>
            <span class="fw-semibold">@Model.id_Categoria</span>
        </div>
        <div class="col-sm-6">
            <small class="text-muted d-block">Nombre</small>
            <span class="fw-semibold">@Model.Nombre</span>
        </div>
    </div>
</div>