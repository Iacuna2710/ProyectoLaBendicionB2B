@{
    ViewData["Title"] = "Página no encontrada";
}
<div class="text-center py-5">
    <div class="auth-icon-circle mx-auto" style="width:96px;height:96px;font-size:2.75rem;">
        <i class="bi bi-map"></i>
    </div>
    <h1 class="fw-bold mt-4">404 — Página no encontrada</h1>
    <p class="text-muted">
        La página que buscás no existe, se movió o la URL está mal escrita.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill mt-2">
        <i class="bi bi-house-fill me-1"></i> Volver al inicio
    </a>
</div>
