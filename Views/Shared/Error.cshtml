@model Pedidos360.Models.ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:4rem;"></i>
    <h1 class="fw-bold mt-3">Algo salió mal</h1>
    <p class="text-muted">Ocurrió un error inesperado. Intenta de nuevo.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Id: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill mt-2">
        <i class="bi bi-house-fill me-1"></i> Volver al inicio
    </a>
</div>