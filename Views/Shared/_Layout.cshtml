<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Macrobiotica La Bendición</title>

    <script>
        // Aplica el tema guardado ANTES de pintar la página, para que no
        // se vea un parpadeo de modo claro al navegar entre pantallas.
        (function () {
            var tema = localStorage.getItem('tema') || 'light';
            document.documentElement.setAttribute('data-bs-theme', tema);
        })();
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">
</head>
<body>
    <div class="app-wrapper">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-flower2 fs-4"></i>
                <div>
                    <div class="fw-bold">Macrobiotica La Bendición</div>
                    <small class="text-white-50" style="font-size:.7rem;opacity:.7;">Sistema de Inventario y Pedido B2B</small>
                </div>
            </div>
            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="sidebar-link@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? " active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>
                @if (User.IsInRole("Admin") || User.IsInRole("Ventas") || User.IsInRole("Operaciones"))
                {
                    <a asp-controller="Productos" asp-action="Index" class="sidebar-link@(ViewContext.RouteData.Values["controller"]?.ToString() == "Productos" ? " active" : "")">
                        <i class="bi bi-box-fill"></i>
                        <span>Productos</span>
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Categorias" asp-action="Index" class="sidebar-link@(ViewContext.RouteData.Values["controller"]?.ToString() == "Categorias" ? " active" : "")">
                        <i class="bi bi-tag-fill"></i>
                        <span>Categorías</span>
                    </a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
                {
                    <a asp-controller="Clientes" asp-action="Index" class="sidebar-link@(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" ? " active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span>Clientes</span>
                    </a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Ventas") || User.IsInRole("Operaciones"))
                {
                    <a asp-controller="Pedido" asp-action="Index" class="sidebar-link@(ViewContext.RouteData.Values["controller"]?.ToString() == "Pedido" ? " active" : "")">
                        <i class="bi bi-cart-check-fill"></i>
                        <span>Pedidos</span>
                    </a>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Ventas"))
                {
                    <a asp-controller="Reportes" asp-action="PorFecha" class="sidebar-link@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? " active" : "")">
                        <i class="bi bi-graph-up"></i>
                        <span>Reportes</span>
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Bitacora" asp-action="Index" class="sidebar-link@(ViewContext.RouteData.Values["controller"]?.ToString() == "Bitacora" ? " active" : "")">
                        <i class="bi bi-clipboard-data-fill"></i>
                        <span>Bitácora</span>
                    </a>
                }
            </nav>
            <div class="sidebar-footer">
                <button class="btn btn-sm btn-outline-secondary w-100" id="themeToggle">
                    <i class="bi bi-moon-stars-fill"></i> Modo oscuro
                </button>
            </div>
        </aside>
        <main class="main-content">
            <header class="topbar">
                <button class="btn btn-link d-md-none me-2" id="sidebarToggle">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="d-none d-md-flex align-items-center gap-2 text-muted small">
                    <i class="bi bi-house-fill"></i>
                    <span>/</span>
                    <span>@ViewData["Title"]</span>
                </div>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <partial name="_LoginPartial" />
                </div>
            </header>
            <div class="content">
                <partial name="_Alerts" />
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>