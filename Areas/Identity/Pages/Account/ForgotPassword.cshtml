@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutAuth";
}

<div class="card-modern auth-card">
    <div class="auth-icon-circle">
        <i class="bi bi-key"></i>
    </div>
    <h2 class="auth-title">¿Olvidaste tu contraseña?</h2>
    <p class="auth-subtitle">Escribe tu correo y te ayudamos a recuperarla.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email" class="form-label"><i class="bi bi-envelope me-1"></i>Correo</label>
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="w-100 btn btn-primary rounded-pill">
            <i class="bi bi-send me-1"></i>Enviar instrucciones
        </button>
    </form>

    <div class="auth-footer">
        <a asp-page="./Login"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
