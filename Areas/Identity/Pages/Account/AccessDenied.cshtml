@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="text-center py-5">
    <div class="auth-icon-circle danger mx-auto" style="width:96px;height:96px;font-size:2.75rem;">
        <i class="bi bi-shield-lock-fill"></i>
    </div>
    <h1 class="fw-bold mt-4">403 — Acceso denegado</h1>
    <p class="text-muted">
        Tu cuenta no tiene permiso para entrar a esta sección del sistema.<br />
        Si crees que esto es un error, consultá con un administrador.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill mt-2">
        <i class="bi bi-house-fill me-1"></i> Volver al inicio
    </a>
</div>
