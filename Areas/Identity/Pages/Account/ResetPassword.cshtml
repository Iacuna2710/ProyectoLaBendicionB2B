@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "_LayoutAuth";
}

<div class="card-modern auth-card">
    <div class="auth-icon-circle">
        <i class="bi bi-shield-lock"></i>
    </div>
    <h2 class="auth-title">Restablecer contraseña</h2>
    <p class="auth-subtitle">Escribe tu correo y la nueva contraseña.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />

        <div class="form-floating mb-3">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email" class="form-label"><i class="bi bi-envelope me-1"></i>Correo</label>
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>
        <div class="form-floating mb-3 password-wrapper">
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nueva contraseña" />
            <label asp-for="Input.Password" class="form-label"><i class="bi bi-lock me-1"></i>Nueva contraseña</label>
            <button type="button" class="password-toggle-btn" tabindex="-1" aria-label="Mostrar contraseña">
                <i class="bi bi-eye"></i>
            </button>
            <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>
        <div class="form-floating mb-3 password-wrapper">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmar contraseña" />
            <label asp-for="Input.ConfirmPassword" class="form-label"><i class="bi bi-lock-fill me-1"></i>Confirmar contraseña</label>
            <button type="button" class="password-toggle-btn" tabindex="-1" aria-label="Mostrar contraseña">
                <i class="bi bi-eye"></i>
            </button>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="w-100 btn btn-primary rounded-pill">
            <i class="bi bi-check-lg me-1"></i>Restablecer
        </button>
    </form>

    <div class="auth-footer">
        <a asp-page="./Login"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
