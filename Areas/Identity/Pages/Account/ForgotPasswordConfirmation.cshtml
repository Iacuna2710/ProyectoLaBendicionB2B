@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Revisa tu correo";
    Layout = "_LayoutAuth";
}

<div class="card-modern auth-card">
    <div class="auth-icon-circle">
        <i class="bi bi-envelope-check"></i>
    </div>
    <h2 class="auth-title">Revisa tu correo</h2>
    <p class="auth-subtitle">
        Si el correo que escribiste está registrado, te enviamos las
        instrucciones para restablecer tu contraseña.
    </p>

    @if (!string.IsNullOrEmpty(Model.LinkDeDesarrollo))
    {
        <div class="alert alert-warning small">
            <i class="bi bi-tools me-1"></i>
            <strong>Modo desarrollo:</strong> este proyecto no tiene un servidor
            de correo real configurado, así que el link queda aquí para poder
            probar el flujo completo.
            <div class="mt-2">
                <a href="@Model.LinkDeDesarrollo" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Abrir link de reseteo
                </a>
            </div>
        </div>
    }

    <div class="auth-footer">
        <a asp-page="./Login"><i class="bi bi-arrow-left me-1"></i>Volver a iniciar sesión</a>
    </div>
</div>
