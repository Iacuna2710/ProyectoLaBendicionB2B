@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña restablecida";
    Layout = "_LayoutAuth";
}

<div class="card-modern auth-card">
    <div class="auth-icon-circle">
        <i class="bi bi-check-circle"></i>
    </div>
    <h2 class="auth-title">¡Listo!</h2>
    <p class="auth-subtitle">Tu contraseña se restableció correctamente.</p>

    <a asp-page="./Login" class="w-100 btn btn-primary rounded-pill">
        <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión
    </a>
</div>
